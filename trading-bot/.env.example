# ============================================================================
# TEMPLATE for your secrets file.
#
# How to use:
#   1. Copy this file to a new file named exactly `.env` (same folder).
#   2. Fill in real values in `.env` only.
#   3. NEVER put real keys in this file — `.env.example` is committed to git
#      as documentation; `.env` is ignored by git (see .gitignore).
#
# Phase 1 (data pipeline) needs NO keys at all — historical candles are
# public data. These variables become relevant in Phase 5 (paper trading).
# ============================================================================

# --- Binance Futures TESTNET keys (fake-money environment) ---
# Create them at https://testnet.binancefuture.com — this is a sandbox with
# pretend money, completely separate from your real Binance account.
BINANCE_TESTNET_API_KEY=your_testnet_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_secret_here

# --- Binance LIVE keys (real money — Phase 6 only, much later) ---
# When you eventually create these:
#   * enable "Futures trading" permission ONLY
#   * make sure "Enable Withdrawals" is OFF — the bot must never be able to
#     move money out of your account even if the keys leak
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# --- Optional: Telegram alerts (later phase) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
