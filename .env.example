# ─────────────────────────────────────────────────────────────
# Zen Residences CRM — Environment Variables
# Copy this file to .env.local and fill in your Supabase values.
# All values below are PUBLIC (safe to expose to the browser) except
# the optional service-role key, which is used only by local scripts.
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (Project Settings → API → anon public)
# This is safe to expose — Row Level Security protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# OPTIONAL — only needed to run the seed script from your machine.
# NEVER commit this and NEVER expose it to the browser. Leave blank in Vercel.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
